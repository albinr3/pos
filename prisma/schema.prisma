// Prisma schema for MOVOPos - Multi-tenant POS System
// Money is stored as integer cents (RD$ 1.00 => 100)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  CAJERO
  ALMACEN
}

enum SaleType {
  CONTADO
  CREDITO
}

enum DocumentDiscountSource {
  NONE
  CUSTOMER
  MANUAL
}

enum AROpenStatus {
  PENDIENTE
  PARCIAL
  PAGADA
}

enum PaymentMethod {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
  OTRO
  DIVIDIR_PAGO // Solo para UI, no se guarda en BD
}

enum TreasuryAccountType {
  CAJA
  BANCO
}

enum TreasuryTransferStatus {
  ACTIVE
  REVERSED
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  SALE_CREATED
  SALE_CANCELLED
  SALE_EDITED
  PAYMENT_CREATED
  PAYMENT_CANCELLED
  PRICE_OVERRIDE
  PRODUCT_CREATED
  PRODUCT_EDITED
  PRODUCT_DELETED
  STOCK_ADJUSTED
  PERMISSION_CHANGED
  SETTINGS_CHANGED
  USER_CREATED
  USER_DELETED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  UNAUTHORIZED_ACCESS
  USER_UPDATED
  USER_DEACTIVATED
  CATEGORY_CREATED
  CATEGORY_EDITED
  CATEGORY_DELETED
  CUSTOMER_CREATED
  CUSTOMER_EDITED
  CUSTOMER_DELETED
  SUPPLIER_CREATED
  SUPPLIER_EDITED
  SUPPLIER_DELETED
  PURCHASE_CREATED
  PURCHASE_EDITED
  PURCHASE_CANCELLED
  RETURN_CREATED
  RETURN_CANCELLED
  QUOTE_CREATED
  QUOTE_EDITED
  QUOTE_DELETED
  OPERATING_EXPENSE_CREATED
  OPERATING_EXPENSE_EDITED
  OPERATING_EXPENSE_DELETED
  BACKUP_CREATED
  BACKUP_DELETED
  BACKUP_RESTORED
  BACKUP_DOWNLOADED
  TREASURY_TRANSFER_CREATED
  TREASURY_TRANSFER_REVERSED
  // Billing actions
  BILLING_SUBSCRIPTION_CREATED
  BILLING_SUBSCRIPTION_UPDATED
  BILLING_PAYMENT_CREATED
  BILLING_PAYMENT_APPROVED
  BILLING_PAYMENT_REJECTED
  BILLING_PROOF_UPLOADED
  BILLING_STATUS_CHANGED
  BILLING_CURRENCY_CHANGED
}

// ==========================================
// BILLING ENUMS
// ==========================================

enum BillingStatus {
  TRIALING // En período de prueba
  ACTIVE // Suscripción activa con pago válido
  GRACE // Período de gracia (3 días después de vencimiento)
  BLOCKED // Bloqueado por falta de pago
  CANCELED // Cancelado por el usuario
}

enum BillingCurrency {
  DOP // Pesos dominicanos
  USD // Dólares estadounidenses
}

enum BillingProvider {
  MANUAL // Transferencia bancaria
  LEMON // Lemon Squeezy (tarjeta)
}

enum BillingPaymentStatus {
  PENDING // Esperando verificación (transferencia)
  PAID // Pagado y verificado
  FAILED // Falló el pago (tarjeta)
  REJECTED // Rechazado (comprobante inválido)
}

enum RegistrationDeviceType {
  DESKTOP
  MOBILE
  UNKNOWN
}

enum RegistrationMethod {
  EMAIL
  GOOGLE
  WHATSAPP
  UNKNOWN
}

enum ManualVerificationStatus {
  NONE // No aplica (pago con tarjeta)
  PENDING // Esperando verificación
  APPROVED // Comprobante aprobado
  REJECTED // Comprobante rechazado
}

enum UnitType {
  UNIDAD // Piezas (default) - solo enteros
  KG // Kilogramos
  LIBRA // Libras
  GRAMO // Gramos
  MILIGRAMO // Miligramos
  ONZA // Onzas (peso)
  TONELADA // Toneladas
  LITRO // Litros
  ML // Mililitros
  ONZA_LIQUIDA // Onzas fluidas
  CC // Centímetros cúbicos
  GALON // Galones
  METRO // Metros
  CM // Centímetros
  MM // Milímetros
  PIE // Pies
  PULGADA // Pulgadas
  YARDA // Yardas
  M3 // Metros cúbicos
}

enum ProductKind {
  BASIC
  MEASURED
  RECIPE
}

enum InventoryBulkSource {
  BULK_EXCEL
  BULK_MANUAL
}

enum InventoryBulkOperationStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
  REVERTED
}

enum RecipeAdjustmentType {
  SIN
  EXTRA
}

// ==========================================
// ACCOUNT (Tenant/Cuenta Principal)
// ==========================================
// Representa un negocio/empresa. Todos los datos están aislados por Account.
model Account {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name        String // Nombre del negocio
  clerkUserId String @unique // ID del usuario Clerk que es dueño
  registeredFromDevice RegistrationDeviceType @default(UNKNOWN)
  registeredWithMethod RegistrationMethod     @default(UNKNOWN)
  registeredUserAgent  String?

  // Relaciones - todos los datos del tenant
  users                User[]
  companySettings      CompanySettings?
  customers            Customer[]
  suppliers            Supplier[]
  categories           Category[]
  products             Product[]
  sales                Sale[]
  purchases            Purchase[]
  operatingExpenses    OperatingExpense[]
  returns              Return[]
  quotes               Quote[]
  auditLogs            AuditLog[]
  inventoryAdjustments InventoryAdjustment[]
  inventoryBulkOperations InventoryBulkOperation[]
  inventoryBulkSnapshots  InventoryBulkSnapshot[]
  invoiceSequences     InvoiceSequence[]
  returnSequence       ReturnSequence?
  quoteSequence        QuoteSequence?
  productSequence      ProductSequence?
  categorySequence     CategorySequence?
  customerSequence     CustomerSequence?
  paymentSequence      PaymentSequence?
  treasuryAccounts     TreasuryAccount[]
  treasuryOpeningBalances TreasuryOpeningBalance[]
  treasuryTransfers    TreasuryTransfer[]
  subUserLoginTokens   SubUserLoginToken[]
  onboarding           AccountOnboarding?

  // Billing
  billingSubscription  BillingSubscription?
  billingProfile       BillingProfile?
  billingNotifications BillingNotification[]

  @@index([clerkUserId])
}

model AccountOnboarding {
  accountId String  @id
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  firstSeenAt             DateTime?
  lastSkippedAt           DateTime?
  completedAt             DateTime?
  firstProductId          String?
  firstSaleId             String?
  productExpressCreatedAt DateTime?
  firstSaleCreatedAt      DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([completedAt])
  @@index([firstProductId])
  @@index([firstSaleId])
}

// ==========================================
// USER (Subcuenta/Operador)
// ==========================================
// Representa un usuario/empleado dentro de un Account.
model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relación con Account (tenant)
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  name         String
  username     String // Único dentro del account
  passwordHash String // Requerido para autenticación de subcuenta
  email        String? // Email opcional
  role         UserRole @default(CAJERO)

  // Si es el dueño/creador del account (admin principal)
  isOwner Boolean @default(false)

  // Autenticación por WhatsApp (legacy, puede ser removido)
  whatsappNumber     String? // Número de WhatsApp en formato E.164
  whatsappVerifiedAt DateTime? // Fecha de verificación del número

  // Granular permissions
  canOverridePrice    Boolean @default(false)
  canCancelSales      Boolean @default(false)
  canCancelReturns    Boolean @default(false)
  canCancelPayments   Boolean @default(false)
  canEditSales        Boolean @default(false)
  canEditProducts     Boolean @default(false)
  canChangeSaleType   Boolean @default(false)
  canSellWithoutStock Boolean @default(false)
  canManageBackups    Boolean @default(false)
  canViewProductCosts Boolean @default(false)
  canViewProfitReport Boolean @default(false)
  canAdjustInventory  Boolean @default(false)
  canManageCategories Boolean @default(false)
  canManagePurchases  Boolean @default(false)
  canCancelPurchases  Boolean @default(false)
  canManageSuppliers  Boolean @default(false)
  canManageCustomers  Boolean @default(false)
  canApproveCredit    Boolean @default(false)
  canManageExpenses   Boolean @default(false)
  canCancelExpenses   Boolean @default(false)
  canManageQuotes     Boolean @default(false)
  canApplyDiscounts   Boolean @default(false)
  canViewAuditLogs    Boolean @default(false)
  canManageUsers      Boolean @default(false)
  canManageSettings   Boolean @default(false)
  canViewTreasury             Boolean @default(false)
  canManageTreasuryAccounts   Boolean @default(false)
  canCreateTreasuryTransfers  Boolean @default(false)
  canReverseTreasuryTransfers Boolean @default(false)

  isActive           Boolean             @default(true)
  subUserLoginTokens SubUserLoginToken[]

  // Relaciones
  sales                Sale[]
  payments             Payment[]
  cancelledPayments    Payment[]             @relation("CancelledPayments")
  purchases            Purchase[]
  cancelledPurchases   Purchase[]            @relation("CancelledPurchases")
  operatingExpenses    OperatingExpense[]
  cancelledSales       Sale[]                @relation("CancelledSales")
  returns              Return[]
  cancelledReturns     Return[]              @relation("CancelledReturns")
  quotes               Quote[]
  whatsappOtps         WhatsappOtp[]
  auditLogs            AuditLog[]
  inventoryAdjustments InventoryAdjustment[]
  inventoryBulkOperations         InventoryBulkOperation[] @relation("InventoryBulkOperationUser")
  revertedInventoryBulkOperations InventoryBulkOperation[] @relation("InventoryBulkOperationRevertedBy")
  treasuryAccountsCreated        TreasuryAccount[]         @relation("TreasuryAccountCreatedBy")
  treasuryOpeningBalancesCreated TreasuryOpeningBalance[]  @relation("TreasuryOpeningBalanceCreatedBy")
  treasuryTransfersCreated       TreasuryTransfer[]        @relation("TreasuryTransferCreatedBy")

  // Username único dentro del mismo account
  @@unique([accountId, username])
  @@index([accountId])
  @@index([whatsappNumber])
  @@index([email])
}

model TreasuryAccount {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  name          String
  type          TreasuryAccountType
  currency      String @default("DOP")
  bankName      String?
  accountNumber String?
  isActive      Boolean @default(true)

  createdByUserId String?
  createdByUser   User? @relation("TreasuryAccountCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  sales             Sale[]             @relation("SaleTreasuryAccount")
  salePayments      SalePayment[]      @relation("SalePaymentTreasuryAccount")
  payments          Payment[]          @relation("PaymentTreasuryAccount")
  purchases         Purchase[]         @relation("PurchaseTreasuryAccount")
  operatingExpenses OperatingExpense[] @relation("OperatingExpenseTreasuryAccount")
  returnRefunds     Return[]           @relation("ReturnRefundTreasuryAccount")
  openingBalances   TreasuryOpeningBalance[]
  outgoingTransfers TreasuryTransfer[] @relation("TreasuryTransferFromAccount")
  incomingTransfers TreasuryTransfer[] @relation("TreasuryTransferToAccount")

  @@unique([accountId, name])
  @@index([accountId, isActive])
  @@index([accountId, type, isActive])
}

model TreasuryOpeningBalance {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  treasuryAccountId String
  treasuryAccount   TreasuryAccount @relation(fields: [treasuryAccountId], references: [id], onDelete: Cascade)

  amountCents Int
  effectiveAt DateTime
  note        String?

  createdByUserId String?
  createdByUser   User? @relation("TreasuryOpeningBalanceCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([accountId, effectiveAt])
  @@index([treasuryAccountId, effectiveAt])
}

model TreasuryTransfer {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  fromTreasuryAccountId String
  fromTreasuryAccount   TreasuryAccount @relation("TreasuryTransferFromAccount", fields: [fromTreasuryAccountId], references: [id], onDelete: Restrict)

  toTreasuryAccountId String
  toTreasuryAccount   TreasuryAccount @relation("TreasuryTransferToAccount", fields: [toTreasuryAccountId], references: [id], onDelete: Restrict)

  amountCents   Int
  transferredAt DateTime
  note          String?

  createdByUserId String
  createdByUser   User @relation("TreasuryTransferCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  status TreasuryTransferStatus @default(ACTIVE)

  reversesTransferId String? @unique
  reversesTransfer   TreasuryTransfer? @relation("TreasuryTransferReversal", fields: [reversesTransferId], references: [id], onDelete: Restrict)
  reversedByTransfer TreasuryTransfer? @relation("TreasuryTransferReversal")

  @@index([accountId, transferredAt])
  @@index([fromTreasuryAccountId, transferredAt])
  @@index([toTreasuryAccountId, transferredAt])
}

model SubUserLoginToken {
  id        String    @id @default(cuid())
  accountId String
  userId    String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([userId])
  @@index([expiresAt])
}

// ==========================================
// COMPANY SETTINGS
// ==========================================
model CompanySettings {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relación con Account
  accountId String  @unique
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  name    String
  phone   String
  address String

  logoUrl String?

  allowNegativeStock    Boolean @default(false)
  itbisRateBp           Int     @default(1800)
  salePricesIncludeItbis Boolean @default(true)
  legalTipEnabled       Boolean @default(false)
  defaultProfitMarginBp Int     @default(3000)
  showItbisOnReceipts   Boolean @default(true)

  barcodeLabelSize  String @default("4x2")
  shippingLabelSize String @default("4x6")
  defaultViewMode   String @default("list")
  
  salePrintFormat    String @default("80mm")
  quotePrintFormat   String @default("80mm")
  paymentPrintFormat String @default("80mm")
  returnPrintFormat  String @default("80mm")

  @@index([accountId])
}

// ==========================================
// SEQUENCES (por Account)
// ==========================================
model InvoiceSequence {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  series     String @default("A")
  lastNumber Int    @default(0)

  @@unique([accountId, series])
  @@index([accountId])
}

model ReturnSequence {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accountId String  @unique
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  lastNumber Int @default(0)

  @@index([accountId])
}

model QuoteSequence {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accountId String  @unique
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  lastNumber Int @default(0)

  @@index([accountId])
}

model ProductSequence {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accountId String  @unique
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  lastNumber Int @default(0)

  @@index([accountId])
}

model CategorySequence {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accountId String  @unique
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  lastNumber Int @default(0)

  @@index([accountId])
}

model CustomerSequence {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accountId String  @unique
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  lastNumber Int @default(0)

  @@index([accountId])
}

model PaymentSequence {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accountId String  @unique
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  lastNumber Int @default(0)

  @@index([accountId])
}

// ==========================================
// CUSTOMER
// ==========================================
model Customer {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  visualId  Int      @map("id_visual")

  name     String
  phone    String?
  address  String?
  cedula   String?
  province String?

  isGeneric Boolean @default(false)
  isActive  Boolean @default(true)

  creditEnabled Boolean @default(false)
  creditDays    Int     @default(0)
  saleDiscountPercentBp Int @default(0)

  sales   Sale[]
  arItems AccountReceivable[]
  quotes  Quote[]

  @@unique([accountId, visualId])
  @@index([accountId])
  @@index([accountId, name])
  @@index([accountId, isGeneric])
}

// ==========================================
// SUPPLIER
// ==========================================
model Supplier {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  notes       String?

  discountPercentBp Int     @default(0)
  chargesItbis      Boolean @default(false)
  itbisRateBp       Int?

  isActive Boolean @default(true)

  products Product[]

  @@index([accountId])
  @@index([accountId, name])
}

// ==========================================
// CATEGORY
// ==========================================
model Category {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accountId  String
  account    Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categoryId Int

  name        String
  description String?
  isActive    Boolean @default(true)

  products Product[]

  // Nombre único dentro del account
  @@unique([accountId, name])
  @@unique([accountId, categoryId])
  @@index([accountId])
  @@index([accountId, categoryId])
  @@index([accountId, isActive])
}

// ==========================================
// PRODUCT
// ==========================================
model Product {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  productId Int

  name String

  sku String?

  reference String?

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  priceCents Int
  costCents  Int

  itbisRateBp Int @default(1800)

  productKind ProductKind @default(BASIC)
  unit        UnitType    @default(UNIDAD)
  stock       Decimal     @default(0) @db.Decimal(10, 3)
  minStock    Decimal     @default(0) @db.Decimal(10, 3)

  isActive Boolean @default(true)
  isAvailableForSale Boolean @default(true)

  imageUrls String[] @default([])

  recipeItems               ProductRecipeItem[]          @relation("RecipeProduct")
  usedAsIngredientInRecipes ProductRecipeItem[]          @relation("RecipeIngredient")
  usedInSaleConsumptions    SaleItemConsumption[]        @relation("SaleConsumptionIngredient")
  usedInSaleAdjustments     SaleItemRecipeAdjustment[]   @relation("SaleAdjustmentIngredient")
  usedInQuoteAdjustments    QuoteItemRecipeAdjustment[]  @relation("QuoteAdjustmentIngredient")
  saleItems                 SaleItem[]
  purchaseItems             PurchaseItem[]
  returnItems               ReturnItem[]
  quoteItems                QuoteItem[]
  inventoryAdjustments      InventoryAdjustment[]

  // productId único dentro del account
  @@unique([accountId, productId])
  // SKU unico por cuenta cuando existe (se aplica con indice unico parcial en migracion SQL)
  @@index([accountId, sku])
  @@index([accountId])
  @@index([accountId, name])
  @@index([accountId, reference])
  @@index([accountId, productKind])
  @@index([supplierId])
  @@index([categoryId])
  @@index([accountId, stock])
  @@index([accountId, isAvailableForSale])
}

model ProductRecipeItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  productId String
  product   Product @relation("RecipeProduct", fields: [productId], references: [id], onDelete: Cascade)

  ingredientId String
  ingredient   Product @relation("RecipeIngredient", fields: [ingredientId], references: [id], onDelete: Restrict)

  qty Decimal @db.Decimal(10, 3)

  @@unique([productId, ingredientId])
  @@index([productId])
  @@index([ingredientId])
}

model InventoryAdjustment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  qtyDelta Decimal @db.Decimal(10, 3)

  reason  String?
  note    String?
  batchId String?

  @@index([accountId, createdAt])
  @@index([productId, createdAt])
  @@index([batchId])
}

model InventoryBulkOperation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  source InventoryBulkSource
  status InventoryBulkOperationStatus @default(IN_PROGRESS)
  reason String?

  userId String?
  user   User?   @relation("InventoryBulkOperationUser", fields: [userId], references: [id], onDelete: SetNull)

  revertedById String?
  revertedBy   User?   @relation("InventoryBulkOperationRevertedBy", fields: [revertedById], references: [id], onDelete: SetNull)

  startedAt   DateTime @default(now())
  completedAt DateTime?
  revertedAt  DateTime?

  totalRows    Int @default(0)
  createdCount Int @default(0)
  updatedCount Int @default(0)
  failedCount  Int @default(0)

  errorMessage String?

  snapshots InventoryBulkSnapshot[]

  @@index([accountId, createdAt])
  @@index([accountId, status, createdAt])
  @@index([userId, createdAt])
}

model InventoryBulkSnapshot {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  operationId String
  operation   InventoryBulkOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  productId String

  existedBefore Boolean
  beforeState   Json?

  @@unique([operationId, productId])
  @@index([accountId, createdAt])
  @@index([operationId])
  @@index([productId])
}

// ==========================================
// SALE
// ==========================================
model Sale {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  invoiceSeries String @default("A")
  invoiceNumber Int
  invoiceCode   String // e.g. A-00001

  soldAt DateTime @default(now())

  type SaleType

  paymentMethod    PaymentMethod?
  transferBankName String?
  treasuryAccountId String?
  treasuryAccount   TreasuryAccount? @relation("SaleTreasuryAccount", fields: [treasuryAccountId], references: [id], onDelete: SetNull)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  subtotalCents Int
  itbisCents    Int
  shippingCents Int @default(0)
  legalTipApplied   Boolean @default(false)
  legalTipPercentBp Int     @default(1000)
  legalTipBaseCents Int     @default(0)
  legalTipCents     Int     @default(0)
  discountSource        DocumentDiscountSource @default(NONE)
  discountPercentBp     Int                    @default(0)
  discountSubtotalCents Int                    @default(0)
  discountTotalCents    Int                    @default(0)
  totalCents    Int
  salePricesIncludeItbis Boolean @default(true)

  notes String?

  cancelledAt   DateTime?
  // Motivo obligatorio al cancelar para trazabilidad y control operativo.
  cancellationReason String?
  cancelledBy   String?
  cancelledUser User?     @relation("CancelledSales", fields: [cancelledBy], references: [id])

  items    SaleItem[]
  payments SalePayment[]
  ar       AccountReceivable?
  returns  Return[]

  // invoiceCode único dentro del account
  @@unique([accountId, invoiceCode])
  @@index([accountId])
  @@index([accountId, soldAt])
  @@index([customerId])
  @@index([cancelledAt])
  @@index([invoiceCode])
  @@index([treasuryAccountId])
}

model SaleItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  qty Decimal @db.Decimal(10, 3)

  unitPriceCents     Int
  costCents          Int     @default(0)
  wasPriceOverridden Boolean @default(false)
  itbisRateBp        Int     @default(1800)

  lineTotalCents Int

  recipeAdjustments SaleItemRecipeAdjustment[]
  consumptions      SaleItemConsumption[]
  returnItems       ReturnItem[]
}

model SaleItemRecipeAdjustment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  saleItemId String
  saleItem   SaleItem @relation(fields: [saleItemId], references: [id], onDelete: Cascade)

  ingredientId   String
  ingredient     Product @relation("SaleAdjustmentIngredient", fields: [ingredientId], references: [id], onDelete: Restrict)
  ingredientName String
  type           RecipeAdjustmentType

  @@unique([saleItemId, ingredientId])
  @@index([ingredientId])
  @@index([saleItemId])
}

model SaleItemConsumption {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  saleItemId String
  saleItem   SaleItem @relation(fields: [saleItemId], references: [id], onDelete: Cascade)

  ingredientId String
  ingredient   Product @relation("SaleConsumptionIngredient", fields: [ingredientId], references: [id], onDelete: Restrict)

  qty Decimal @db.Decimal(10, 3)

  @@index([saleItemId])
  @@index([ingredientId])
}

model SalePayment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  method           PaymentMethod
  transferBankName String?
  treasuryAccountId String?
  treasuryAccount   TreasuryAccount? @relation("SalePaymentTreasuryAccount", fields: [treasuryAccountId], references: [id], onDelete: SetNull)
  amountCents      Int

  @@index([saleId])
  @@index([treasuryAccountId])
}

// ==========================================
// ACCOUNTS RECEIVABLE
// ==========================================
model AccountReceivable {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  saleId String @unique
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  totalCents   Int
  balanceCents Int
  status       AROpenStatus @default(PENDIENTE)

  dueDate DateTime?

  payments Payment[]

  @@index([status])
  @@index([customerId])
  @@index([dueDate])
}

model Payment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  arId String
  ar   AccountReceivable @relation(fields: [arId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  receiptNumber Int
  receiptCode   String // e.g. R-000001

  paidAt           DateTime      @default(now())
  amountCents      Int
  method           PaymentMethod @default(EFECTIVO)
  transferBankName String?
  treasuryAccountId String?
  treasuryAccount   TreasuryAccount? @relation("PaymentTreasuryAccount", fields: [treasuryAccountId], references: [id], onDelete: SetNull)
  note             String?

  cancelledAt   DateTime?
  // Motivo obligatorio al cancelar para trazabilidad y control operativo.
  cancellationReason String?
  cancelledBy   String?
  cancelledUser User?     @relation("CancelledPayments", fields: [cancelledBy], references: [id])

  @@index([paidAt])
  @@index([cancelledAt])
  @@index([receiptCode])
  @@index([treasuryAccountId])
}

// ==========================================
// AUDIT LOG
// ==========================================
model AuditLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  userId       String?
  user         User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail    String?
  userUsername String?

  action       AuditAction
  resourceType String?
  resourceId   String?
  details      Json?
  oldValue     Json?
  newValue     Json?
  ipAddress    String?
  userAgent    String?

  @@index([accountId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
}

// ==========================================
// PURCHASE
// ==========================================
model Purchase {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  purchasedAt  DateTime @default(now())
  supplierName String?
  paymentMethod PaymentMethod?
  treasuryAccountId String?
  treasuryAccount   TreasuryAccount? @relation("PurchaseTreasuryAccount", fields: [treasuryAccountId], references: [id], onDelete: SetNull)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  totalCents Int
  notes      String?

  cancelledAt   DateTime?
  cancelledBy   String?
  cancelledUser User?     @relation("CancelledPurchases", fields: [cancelledBy], references: [id])

  items PurchaseItem[]

  @@index([accountId])
  @@index([accountId, purchasedAt])
  @@index([cancelledAt])
  @@index([treasuryAccountId])
}

model PurchaseItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  qty                   Decimal  @db.Decimal(10, 3)
  unitCostCents         Int
  discountPercentBp     Int      @default(0)
  netCostCents          Int      @default(0)
  salePriceCents        Int?
  saleMarginBp          Int?
  purchaseIncludesItbis Boolean?
  appliedItbisRateBp    Int?
  lineTotalCents        Int
}

// ==========================================
// OPERATING EXPENSE
// ==========================================
model OperatingExpense {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  description String
  amountCents Int
  paymentMethod PaymentMethod?
  treasuryAccountId String?
  treasuryAccount   TreasuryAccount? @relation("OperatingExpenseTreasuryAccount", fields: [treasuryAccountId], references: [id], onDelete: SetNull)
  expenseDate DateTime @default(now())
  category    String?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  notes String?

  @@index([accountId])
  @@index([accountId, expenseDate])
  @@index([treasuryAccountId])
}

// ==========================================
// RETURN
// ==========================================
model Return {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  returnNumber Int
  returnCode   String // e.g. DEV-00001

  returnedAt DateTime @default(now())

  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id])

  refundMethod           PaymentMethod?
  refundTreasuryAccountId String?
  refundTreasuryAccount   TreasuryAccount? @relation("ReturnRefundTreasuryAccount", fields: [refundTreasuryAccountId], references: [id], onDelete: SetNull)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  subtotalCents Int
  itbisCents    Int
  discountPercentBp     Int @default(0)
  discountSubtotalCents Int @default(0)
  discountTotalCents    Int @default(0)
  legalTipCents         Int @default(0)
  totalCents    Int
  salePricesIncludeItbis Boolean @default(true)

  notes String?

  cancelledAt   DateTime?
  cancelledBy   String?
  cancelledUser User?     @relation("CancelledReturns", fields: [cancelledBy], references: [id])

  items ReturnItem[]

  // returnNumber y returnCode únicos dentro del account
  @@unique([accountId, returnNumber])
  @@unique([accountId, returnCode])
  @@index([accountId])
  @@index([accountId, returnedAt])
  @@index([saleId])
  @@index([cancelledAt])
  @@index([refundTreasuryAccountId])
}

model ReturnItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  returnId String
  return   Return @relation(fields: [returnId], references: [id], onDelete: Cascade)

  saleItemId String
  saleItem   SaleItem @relation(fields: [saleItemId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  qty Decimal @db.Decimal(10, 3)

  unitPriceCents Int
  itbisRateBp    Int @default(1800)
  lineTotalCents Int
}

// ==========================================
// QUOTE
// ==========================================
model Quote {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  quoteNumber Int
  quoteCode   String // e.g. COT-00001

  quotedAt   DateTime  @default(now())
  validUntil DateTime?

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  subtotalCents Int
  itbisCents    Int
  shippingCents Int @default(0)
  discountSource        DocumentDiscountSource @default(NONE)
  discountPercentBp     Int                    @default(0)
  discountSubtotalCents Int                    @default(0)
  discountTotalCents    Int                    @default(0)
  totalCents    Int
  salePricesIncludeItbis Boolean @default(true)

  notes String?

  items QuoteItem[]

  // quoteNumber y quoteCode únicos dentro del account
  @@unique([accountId, quoteNumber])
  @@unique([accountId, quoteCode])
  @@index([accountId])
  @@index([accountId, quotedAt])
  @@index([customerId])
  @@index([validUntil])
}

model QuoteItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  qty Decimal @db.Decimal(10, 3)

  unitPriceCents     Int
  wasPriceOverridden Boolean @default(false)
  itbisRateBp        Int     @default(1800)

  lineTotalCents Int

  recipeAdjustments QuoteItemRecipeAdjustment[]
}

model QuoteItemRecipeAdjustment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  quoteItemId String
  quoteItem   QuoteItem @relation(fields: [quoteItemId], references: [id], onDelete: Cascade)

  ingredientId   String
  ingredient     Product @relation("QuoteAdjustmentIngredient", fields: [ingredientId], references: [id], onDelete: Restrict)
  ingredientName String
  type           RecipeAdjustmentType

  @@unique([quoteItemId, ingredientId])
  @@index([ingredientId])
  @@index([quoteItemId])
}

// ==========================================
// BILLING PLAN (Planes de precios personalizados)
// ==========================================
model BillingPlan {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name        String // "Plan Estándar", "Plan Promocional", "Plan VIP"
  description String?

  // Precios en centavos
  priceUsdCents Int // Precio en USD (ej: 2000 = $20.00)
  priceDopCents Int // Precio en DOP (ej: 130000 = RD$1,300.00)

  // Lemon Squeezy variant para este plan (para pagos USD)
  lemonVariantId String?

  // Control
  isDefault Boolean @default(false) // Solo uno puede ser default
  isActive  Boolean @default(true)

  // Relaciones
  subscriptions BillingSubscription[]

  @@index([isActive])
  @@index([isDefault])
}

// ==========================================
// BANK ACCOUNTS (for DOP transfers)
// ==========================================
// Cuentas bancarias disponibles para transferencias
model BankAccount {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bankName      String // Nombre del banco (ej: "Banco Popular Dominicano")
  accountType   String // Tipo de cuenta (ej: "Cuenta de Ahorros", "Cuenta Corriente")
  accountNumber String // Número de cuenta
  accountName   String // Nombre del titular
  currency      String @default("DOP") // Moneda de la cuenta

  // Información adicional opcional
  bankLogo     String? // URL del logo del banco
  instructions String? // Instrucciones adicionales

  isActive     Boolean @default(true)
  displayOrder Int     @default(0) // Para ordenar en la UI

  payments BillingPayment[]

  @@index([isActive, displayOrder])
}

// ==========================================
// BILLING SUBSCRIPTION
// ==========================================
// Estado de la suscripción de billing (1:1 con Account)
model BillingSubscription {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accountId String  @unique
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  status   BillingStatus   @default(TRIALING)
  currency BillingCurrency @default(DOP)
  provider BillingProvider @default(MANUAL)

  // Plan de precios asignado
  billingPlanId String?
  billingPlan   BillingPlan? @relation(fields: [billingPlanId], references: [id])

  // Trial
  trialStartedAt DateTime?
  trialEndsAt    DateTime?

  // Período actual de facturación
  currentPeriodStartsAt DateTime?
  currentPeriodEndsAt   DateTime?

  // Período de gracia (3 días después del vencimiento)
  graceEndsAt DateTime?

  // Cambios pendientes para el próximo ciclo
  pendingCurrency BillingCurrency?
  pendingProvider BillingProvider?

  // Verificación manual (transferencias DOP)
  manualVerificationStatus ManualVerificationStatus @default(NONE)
  manualAccessGrantedAt    DateTime? // Cuando se subió el primer comprobante

  // Lemon Squeezy IDs
  lemonCustomerId     String?
  lemonSubscriptionId String?

  // Precios en centavos (copiados del plan al asignar)
  priceUsdCents Int @default(2000) // $20.00 USD
  priceDopCents Int @default(130000) // RD$1,300 DOP (incluye impuestos)

  payments BillingPayment[]

  @@index([accountId])
  @@index([status])
  @@index([trialEndsAt])
  @@index([currentPeriodEndsAt])
  @@index([graceEndsAt])
  @@index([billingPlanId])
}

// ==========================================
// BILLING PROFILE
// ==========================================
// Datos fiscales para recibos (1:1 con Account)
model BillingProfile {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accountId String  @unique
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  legalName String // Nombre legal o razón social
  taxId     String // Cédula o RNC
  address   String // Dirección fiscal
  email     String // Email para recibos
  phone     String? // Teléfono (opcional)

  @@index([accountId])
}

// ==========================================
// BILLING PAYMENT
// ==========================================
// Registro de pagos de billing
model BillingPayment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptionId String
  subscription   BillingSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  amountCents Int
  currency    BillingCurrency
  provider    BillingProvider

  status          BillingPaymentStatus @default(PENDING)
  paidAt          DateTime?
  rejectionReason String?

  // Para transferencias manuales
  reference     String? // Referencia de la transferencia
  bankAccountId String? // Cuenta bancaria elegida por el usuario
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id])

  // Para Lemon Squeezy
  externalId String? // ID de invoice/subscription en Lemon

  // Período que cubre este pago
  periodStartsAt DateTime?
  periodEndsAt   DateTime?

  proofs   BillingPaymentProof[]
  receipts BillingReceipt[]

  @@index([subscriptionId])
  @@index([status])
  @@index([createdAt])
  @@index([externalId])
  @@index([bankAccountId])
}

// ==========================================
// BILLING PAYMENT PROOF
// ==========================================
// Comprobantes de transferencia (0..n por pago)
model BillingPaymentProof {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  paymentId String
  payment   BillingPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  url         String // URL del archivo en UploadThing
  uploadedAt  DateTime @default(now())
  amountCents Int? // Monto del comprobante (opcional)
  note        String? // Nota adicional

  @@index([paymentId])
}

// ==========================================
// BILLING RECEIPT
// ==========================================
// Recibos internos generados (sin NCF)
model BillingReceipt {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  paymentId String
  payment   BillingPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  receiptNumber String    @unique // Número de recibo interno (e.g., REC-00001)
  issuedAt      DateTime  @default(now())
  emailSentAt   DateTime? // Cuando se envió por email

  // Snapshot de datos del perfil al momento de emisión
  legalName String
  taxId     String
  address   String

  @@index([paymentId])
  @@index([receiptNumber])
}

// ==========================================
// BILLING NOTIFICATION
// ==========================================
// Historial de notificaciones de billing enviadas
model BillingNotification {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  type    String // trial_7, trial_3, due_3, due_1, grace_2, blocked, etc.
  channel String // email, in_app
  sentAt  DateTime @default(now())

  // Metadata adicional
  metadata Json?

  @@index([accountId])
  @@index([accountId, type])
  @@index([sentAt])
}

// ==========================================
// SUPER ADMIN
// ==========================================

enum SuperAdminRole {
  OWNER // Acceso total
  ADMIN // Puede gestionar cuentas y pagos
  FINANCE // Solo puede ver y aprobar pagos
  SUPPORT // Solo puede ver información, no modificar
}

enum SuperAdminNotificationType {
  TRANSFER_PENDING_REVIEW
  CARD_PAYMENT_SUCCESS
  CARD_PAYMENT_FAILED
  ERROR_HIGH
  ERROR_CRITICAL
}

model SuperAdmin {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email        String         @unique
  name         String
  passwordHash String
  role         SuperAdminRole @default(SUPPORT)

  lastLoginAt DateTime?
  isActive    Boolean   @default(true)

  // Permisos granulares
  canManageAccounts  Boolean @default(false)
  canApprovePayments Boolean @default(false)
  canModifyPricing   Boolean @default(false)
  canSendEmails      Boolean @default(false)
  canDeleteAccounts  Boolean @default(false)
  canViewFinancials  Boolean @default(true)

  auditLogs SuperAdminAuditLog[]
  notificationsRead SuperAdminNotification[] @relation("NotificationReadBy")

  @@index([email])
  @@index([isActive])
}

// ==========================================
// SUPER ADMIN AUDIT LOG
// ==========================================
model SuperAdminAuditLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  superAdminId String
  superAdmin   SuperAdmin @relation(fields: [superAdminId], references: [id], onDelete: Cascade)

  action          String // approved_payment, blocked_account, etc.
  targetAccountId String?
  targetPaymentId String?

  metadata  Json?
  ipAddress String?

  @@index([superAdminId])
  @@index([createdAt])
  @@index([action])
}

model SuperAdminNotification {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  type    SuperAdminNotificationType
  title   String
  message String
  href    String

  metadata Json?
  sourceId String

  isRead Boolean   @default(false)
  readAt DateTime?
  readBySuperAdminId String?
  readBySuperAdmin   SuperAdmin? @relation("NotificationReadBy", fields: [readBySuperAdminId], references: [id], onDelete: SetNull)

  @@unique([type, sourceId])
  @@index([createdAt])
  @@index([isRead])
  @@index([type])
}

// ==========================================
// ERROR LOG (Sistema de monitoreo de errores)
// ==========================================
enum ErrorSeverity {
  LOW // Errores menores, no afectan funcionalidad
  MEDIUM // Errores que afectan parcialmente
  HIGH // Errores críticos que bloquean funcionalidad
  CRITICAL // Errores que afectan todo el sistema
}

model ErrorLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // Información del error
  message  String
  stack    String?       @db.Text
  code     String? // Código de error personalizado (ej: "PAYMENT_FAILED", "DB_CONNECTION")
  severity ErrorSeverity @default(MEDIUM)

  // Contexto
  accountId String? // Cuenta afectada (si aplica)
  userId    String? // Usuario que causó el error (si aplica)
  userEmail String? // Email del usuario que causó el error (si aplica)
  userPhone String? // Telefono (whatsappNumber) del usuario que causó el error (si aplica)
  endpoint  String? // Ruta/endpoint donde ocurrió
  urlPath   String? // Ruta interna del frontend donde ocurrió (sin dominio/query)
  method    String? // GET, POST, etc.

  // Request info
  requestBody Json? // Body del request (sanitizado)
  queryParams Json? // Query parameters
  ipAddress   String?
  userAgent   String?

  // Metadatos adicionales
  metadata Json? // Cualquier dato adicional relevante

  // Resolución
  resolved   Boolean   @default(false)
  resolvedAt DateTime?
  resolvedBy String? // ID del super admin que lo resolvió
  resolution String? // Notas de resolución

  @@index([createdAt])
  @@index([severity])
  @@index([resolved])
  @@index([accountId])
  @@index([code])
  @@index([endpoint])
  @@index([urlPath])
}

// ==========================================
// TUTORIAL LIBRARY (marketing + super-admin)
// ==========================================
model TutorialCategory {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slug        String @unique
  label       String
  description String
  displayOrder Int   @default(0)
  isActive    Boolean @default(true)

  videos TutorialVideo[]

  @@index([isActive, displayOrder])
}

model TutorialVideo {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slug        String @unique
  title       String
  description String

  categoryId String
  category   TutorialCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  duration String
  level    String
  outcomes String[] @default([])

  videoUrl     String
  videoFileKey String

  isPublished Boolean @default(false)
  isFeatured  Boolean @default(false)
  displayOrder Int    @default(0)

  @@index([isPublished, displayOrder])
  @@index([categoryId, displayOrder])
}

// ==========================================
// WHATSAPP OTP (legacy)
// ==========================================
model WhatsappOtp {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  phoneNumber String
  code        String
  expiresAt   DateTime
  consumedAt  DateTime?
  purpose     String
  attempts    Int       @default(0)
  ipAddress   String?
  userAgent   String?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phoneNumber, createdAt])
  @@index([phoneNumber, expiresAt])
  @@index([expiresAt])
}
